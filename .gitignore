# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
ENV/

# Secrets — never commit real credentials (see .env.example)
.env
.env.bak
*.pem
*.key

# Data — raw snapshots and local databases are generated, not versioned
data/
*.db
*.sqlite
*.sqlite3

# Test / tool caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.playwright-mcp/

# Operater runtime state on the VPS checkout — untracked BY DESIGN, and the
# CD dirty-tree guard must not treat them as local modifications:
#   live-armed      operator gate for starting the real-money loop
#   chrome-profile/ the browser's live profile (book session)
#   scripts/        deploy target for atlas_alert.py (applied by atlas-apply.sh)
#   .cd-*           CD rollback state
/live-armed
/chrome-profile/
/scripts/
/.cd-backup/
/.cd-lastgood
