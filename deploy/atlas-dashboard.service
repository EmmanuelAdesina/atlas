[Unit]
Description=ATLAS control dashboard
After=network-online.target atlas-loop.service
Wants=network-online.target

[Service]
Type=simple
User=atlas
Group=atlas
WorkingDirectory=/opt/atlas
EnvironmentFile=/opt/atlas/.env
ExecStart=/opt/atlas/.venv/bin/python -m atlas.main run --dashboard
Restart=always
RestartSec=10
TimeoutStopSec=20

# Bind to the VPS interface so the dashboard is reachable. Keep it on
# 127.0.0.1 and use an SSH tunnel if the box has no firewall in front of it.
Environment=ATLAS_HOST=0.0.0.0
Environment=ATLAS_PORT=8077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/atlas/data

[Install]
WantedBy=multi-user.target
