[Unit]
Description=ATLAS Chrome (SportyBet plane) - the designated OOM victim
After=network-online.target atlas-xvfb.service
Wants=network-online.target atlas-xvfb.service

[Service]
Type=simple
User=reliastra
Group=reliastra
Environment=HOME=/home/reliastra
Environment=DISPLAY=:0
# No kimi daemon anymore (2026-11-02): the CDP-first transport replaced it,
# and its extension was the flaky layer + renderer memory. Chrome starts
# CLEAN, extensions forced off (the old install policy is removed by apply).
ExecStartPre=/usr/local/sbin/atlas-chrome-session-clean.sh
ExecStart=/usr/bin/google-chrome \
  --user-data-dir=/opt/atlas/chrome-profile \
  --no-first-run --no-default-browser-check \
  --start-maximized --force-renderer-accessibility \
  --disable-backgrounding-occluded-windows --disable-renderer-backgrounding \
  --disable-gpu --disable-dev-shm-usage \
  --disk-cache-size=33554432 \
  --js-flags=--max-old-space-size=384 \
  --disable-extensions \
  --remote-debugging-port=9222 \
  --window-position=0,0 --window-size=1920,1080 \
  about:blank
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
OOMScoreAdjust=800
MemoryHigh=650M
MemoryMax=900M
CPUWeight=120
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
