[Unit]
Description=ATLAS control dashboard (read-only observer + posture steer)
After=network-online.target atlas-shadow.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/atlas
EnvironmentFile=/opt/atlas/.env
ExecStart=/opt/atlas/.venv/bin/python -m atlas.main run --dashboard
Restart=always
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGINT
Nice=5
MemoryHigh=250M
MemoryMax=400M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/atlas/data

[Install]
WantedBy=multi-user.target
