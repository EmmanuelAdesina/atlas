# ATLAS configuration.
#
# Copy to `.env` and fill in. The odds and statistics come from the live
# SportyBet DOM, so NO sports-data API key is needed for the model to work.
# The only key below is for the optional LLM posture proposer.

# --- Notifications (optional) ---------------------------------------------
# Where custom notifications are pushed. A Telegram/Slack/phone-push webhook.
# The posture changes, the daily stop, placement failures and cashout actions
# all go here.
ATLAS_WEBHOOK_URL=
# Optional bearer token for the webhook.
ATLAS_WEBHOOK_TOKEN=

# --- LLM posture proposer (optional) ---------------------------------------
# With a key, an operator instruction can be interpreted by a model. Without
# one, the deterministic rule-based parser handles the same instructions.
# Any OpenAI-compatible endpoint works.
ATLAS_BOSS_API_KEY=
ATLAS_BOSS_BASE_URL=https://api.openai.com/v1
ATLAS_BOSS_MODEL=gpt-4o-mini

# --- Control dashboard ------------------------------------------------------
# 0.0.0.0 binds the dashboard to every interface, which is what a VPS needs.
# Keep it on 127.0.0.1 if the dashboard is behind a tunnel or an SSH port
# forward.
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8077

# --- WebBridge browser session ----------------------------------------------
# The name of the browser session the loop drives.
ATLAS_WEBBRIDGE_SESSION=atlas-live
