# ATLAS configuration.
#
# Copy to `.env` and fill in. The odds and statistics come from the live
# SportyBet DOM, so NO sports-data API key is needed for the model to work.
# The only key below is for the optional LLM posture proposer.

# --- Notifications (optional) ---------------------------------------------
# Where custom notifications are pushed. A Telegram/Slack/phone-push webhook.
# The posture changes, the daily stop, placement failures and cashout actions
# all go here.
ATLAS_WEBHOOK_URL=
# Optional bearer token for the webhook.
ATLAS_WEBHOOK_TOKEN=

# --- LLM posture proposer + supervisor (optional) --------------------------
# With a key, the supervisor can reason about the exception path (an expired
# session, an unexpected page, a wedged browser) and can see a screenshot of
# the page. Any OpenAI-compatible endpoint works (OpenRouter, OpenAI, a local
# server). A free model is enough: the supervisor only handles exceptions.
ATLAS_BOSS_API_KEY=
ATLAS_BOSS_BASE_URL=https://openrouter.ai/api/v1
ATLAS_BOSS_MODEL=minimax/minimax-m3.1-flash

# --- SportyBet session (optional) -----------------------------------------
# The supervisor re-logs in when the session expires. The credentials are
# read from here and typed into the form by the tool, so they never enter a
# model's context, a prompt or a log.
ATLAS_SPORTYBET_PHONE=
ATLAS_SPORTYBET_PASSWORD=

# --- Browserless transport (experimental, see docs/browserless-transport-design.md)
# Direct-HTTP sensors for SportyBet. Everything here is READ-ONLY except the
# DirectOrderExecutor, which is not wired into the runner and refuses to run
# without an explicit allow_submit=True plus a Phase A order recipe.
# Path to the seeded cookie vault (0600 JSON: {"cookies": {...}, ...}).
# Seed with: python -m atlas.transport.seed --cookies cookies.json
ATLAS_SESSION_VAULT=data/ops/session.json
# Path to the archived Phase A Outcomes (board) request recipe. Board reads
# refuse until this exists. Do NOT hand-write one without a capture.
ATLAS_BOARD_OUTCOMES_BODY=
# Path to the archived Phase A order-placement recipe + injected verifier.
# Direct order submission refuses until BOTH exist and allow_submit=True is
# passed behind --submit and the campaign wall. Leave empty.
ATLAS_ORDER_RECIPE=
# Append-only audit of refused direct orders (never positions; zero exposure).
ATLAS_REFUSAL_LOG=data/ops/order_refusals.jsonl

# --- WebBridge browser session ----------------------------------------------
# The name of the browser session the loop drives.
ATLAS_WEBBRIDGE_SESSION=atlas-live

# --- AI-first agent plane (opencode over the live tab) -----------------------
# The agent REPLACES the deterministic decision core: opencode explores the
# venue page, reads the live match statistics, prices, and places bets — all
# through the tab tool (python -m atlas.agent.tab) and the WebBridge daemon.
# Daemon URL comes from ATLAS_WEBBRIDGE_DAEMON_URL above (VPS: 127.0.0.1).
#
# Money interaction (click/fill/upload) is REFUSED unless this is 1.
# Arming is an operator decision, never an agent one.
ATLAS_AGENT_MONEY=0
# The agent's own hard daily stop for recorded positions (NGN).
ATLAS_AGENT_DAILY_LOSS_LIMIT=-500
# Comma-separated opencode sessions (one conversation per tracked match role).
ATLAS_AGENT_SESSIONS=atlas-trader
# Seconds between orchestrator cycles.
ATLAS_AGENT_CYCLE_S=90
# Pin the binary if `opencode` is not on the VPS PATH.
ATLAS_AGENT_OPENCODE_BIN=opencode
# Model passed to `opencode run --model` (provider/model, e.g. github-copilot/gpt-5.2).
ATLAS_AGENT_MODEL=
# An opencode profile agent (`--agent`), optional.
ATLAS_AGENT_NAME=atlas-trader
# Attach to a persistent opencode serve instance instead of spawning the CLI
# (e.g. http://127.0.0.1:4096). Empty = spawn the CLI process directly.
ATLAS_AGENT_OPENCODE_URL=
# One opencode cycle's ceiling in seconds. Reasoning over a live board is
# slow; the orchestrator kills the brain past this and backs off.
ATLAS_AGENT_TIMEOUT_S=1800

# --- Telemetry (OTLP push; the loop has no HTTP server) ----------------------
# The ONLY observability surface: outbound OTLP/HTTP (protobuf) to any
# collector — e.g. http://collector:4318, or a vendor endpoint. Empty = no
# telemetry, the loop runs exactly the same.
# The exporter appends /v1/metrics and /v1/traces when you pass a bare base.
ATLAS_OTLP_ENDPOINT=
# Optional "k=v;k=v" exporter headers (e.g. auth).
ATLAS_OTLP_HEADERS=
# Export cadence in seconds (default 15) and per-request timeout (default 10).
ATLAS_OTLP_INTERVAL_S=
ATLAS_OTLP_TIMEOUT_S=
