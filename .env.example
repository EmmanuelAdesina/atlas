# Copy to .env and fill in real values. NEVER commit .env with real keys.
# (A placeholder .env was previously committed by mistake; it is now untracked.)

# --- Football data (optional, legacy) ---
FOOTBALL_DATA_API_KEY=
ODDS_API_KEY=

# --- Paths ---
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
DATABASE_URL=sqlite:///data/database/atlas.db

# --- HTTP client ---
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RATE_LIMIT_PER_SECOND=5
LOG_LEVEL=INFO
